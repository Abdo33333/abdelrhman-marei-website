# Analytics IDs — add these in your hosting provider's environment settings.
VITE_GA4_MEASUREMENT_ID=
VITE_META_PIXEL_ID=
VITE_TIKTOK_PIXEL_ID=

# Optional: endpoint that receives lead submissions (Google Apps Script, Make, n8n, CRM webhook, etc.).
# The site will continue opening WhatsApp if this is empty.
VITE_LEAD_WEBHOOK_URL=

# Set after choosing the production domain, e.g. https://abdelrhmanmarei.com
# Used for absolute URLs where needed.
VITE_SITE_URL=
